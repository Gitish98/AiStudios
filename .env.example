# ─────────────────────────────────────────────────────────────────────────────
#  AiStudios — environment template
#
#  HOW TO USE:  cp .env.example .env   then fill in your PAPER keys only.
#  The real .env is gitignored and must NEVER be committed.
#
#  All values below are FAKE PLACEHOLDERS. Replace them with your own keys.
#  Paper and live keys are DIFFERENT credentials in DIFFERENT variables.
#  The system refuses to go live unless the live keys exist AND differ from paper.
# ─────────────────────────────────────────────────────────────────────────────

# ── Trading mode ─────────────────────────────────────────────────────────────
# Anything other than "live" resolves to PAPER. Leave as paper.
# Setting this to "live" is necessary but NOT sufficient to trade live
# (see docs/05-risk-and-safety.md §1.2 — five independent gates must all pass).
TRADING_MODE=paper

# ── Alpaca — PAPER (execution + market data + options chains) ────────────────
# Get free paper keys at https://alpaca.markets (paper account, no funding needed).
ALPACA_PAPER_KEY=PKFAKE0000EXAMPLE0000
ALPACA_PAPER_SECRET=fake_paper_secret_replace_me_0000000000000000
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets

# ── Alpaca — LIVE (leave BLANK until you have validated an edge and read §1) ──
# These MUST be different from the paper keys above. The go-live gate checks this.
# Provision a least-privilege key with NO money-movement permission.
ALPACA_LIVE_KEY=
ALPACA_LIVE_SECRET=
ALPACA_LIVE_BASE_URL=https://api.alpaca.markets

# ── Tradier — SANDBOX (option chains; greeks/IV are best-effort, see note) ────
# Free sandbox token with an account at https://tradier.com.
# NOTE: sandbox greeks/IV are often null/intermittent. The core falls back to
# Black-Scholes greeks computed from chain mids (see docs/04 §0.2). Do not
# assume vendor greeks are populated.
TRADIER_SANDBOX_TOKEN=fake_tradier_sandbox_token_replace_me
TRADIER_SANDBOX_BASE_URL=https://sandbox.tradier.com

# ── Tradier — PRODUCTION (optional; better greeks/IV than sandbox) ────────────
# Free with a funded-but-unused account. Leave blank in Phase 0.
TRADIER_PROD_TOKEN=
TRADIER_PROD_BASE_URL=https://api.tradier.com

# ── Claude / Anthropic (the reasoning layer) ─────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-FAKE-replace-me-0000000000000000000000

# ── Optional research / data providers (deferred past Phase 0; leave blank) ──
# Add only when a strategy actually consumes them (see docs/02 §3.1 phasing).
FINNHUB_API_KEY=
TAVILY_API_KEY=
PERPLEXITY_API_KEY=
# FINRA short-interest API (OAuth2 client-credentials; only if using the API
# rather than the free public flat files — see docs/02 §2.5).
FINRA_API_CLIENT_ID=
FINRA_API_CLIENT_SECRET=

# ── Supabase (optional hosted state; default is local SQLite) ────────────────
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
