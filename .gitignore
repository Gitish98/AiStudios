# ── Secrets — NEVER commit these ────────────────────────────────────────────
.env
.env.*
!.env.example
*.key
*.pem
secrets/
~/.trading/
.trading/
# Your real config copies (may contain account-specific values). Inline comments
# are NOT allowed on .gitignore pattern lines, so keep these bare.
config/config.yaml
config/watchlist.yaml
# The heartbeat ping URL is a bearer secret: anyone holding it can post a fake
# "I'm alive" and mask a real outage. docs + CLAUDE.md described this file as
# gitignored since the wrapper was written; it never actually was, so `git add
# -A` on the VM would have committed it the moment it existed.
.healthcheck_url
# Keep the *.example.yaml templates tracked; ignore the live copies above.

# ── State / data ────────────────────────────────────────────────────────────
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
/data/
portfolio.db

# ── Generated artifacts ─────────────────────────────────────────────────────
dashboard/out/
exports/
*.log
logs/

